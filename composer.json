{
    "name": "xbrowser/xbrowser",
    "description": "A terminal-based browser powered by Chrome DevTools Protocol",
    "type": "project",
    "license": "MIT",
    "keywords": ["browser", "terminal", "cli", "cdp", "headless", "chromium", "automation"],
    "authors": [
        {
            "name": "Xbrowser Contributors",
            "email": "contributors@xbrowser.dev"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Xbrowser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xbrowser\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/Xbrowser"],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
